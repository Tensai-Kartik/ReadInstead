# ReadInstead Frontend Environment Variables
# Copy this file to .env or configure these variables in Vercel Project Settings

# Live Supabase Project URL & Anon/Publishable Key
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Backend FastAPI Server URL (e.g., http://localhost:8000 or your hosted production API URL)
VITE_BACKEND_URL=http://localhost:8000
